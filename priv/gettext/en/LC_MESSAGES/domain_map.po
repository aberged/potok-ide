msgid "published at"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:901
#, elixir-autogen, elixir-format
msgid "A reaction is the exception: an app adds it for any viewer who may react, only to a group below it, and the viewer can take it back."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:491
#, elixir-autogen, elixir-format
msgid "An emoji of one profile on a group, as on a story in a news feed. A profile cannot use the same emoji twice on the same group."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:822
#, elixir-autogen, elixir-format
msgid "For each <Group>group</Group> below it, it gets the number of messages in its chat and its <GroupReaction>reactions</GroupReaction>. It can add the viewer's reaction and open the sharing of the group's link. That is how a story in a feed gets comments, reactions and a share button."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:820
#, elixir-autogen, elixir-format
msgid "Gathers reactions and comments"
msgstr ""

