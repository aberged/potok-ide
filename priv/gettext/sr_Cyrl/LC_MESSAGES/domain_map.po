msgid "Composite keys"
msgstr "Сложени кључеви"

#: lib/potok_ide_web/domain_copy.ex:568
#, elixir-autogen, elixir-format
msgid "Content"
msgstr "Садржај"

#: lib/potok_ide_web/domain_copy.ex:1201
#, elixir-autogen, elixir-format
msgid "Core"
msgstr "Језгро"

#: lib/potok_ide_web/domain_copy.ex:1126
#, elixir-autogen, elixir-format
msgid "Deleting a row in the database"
msgstr "Брисање реда у бази"

#: lib/potok_ide_web/domain_copy.ex:600
#, elixir-autogen, elixir-format
msgid "Event"
msgstr "Догађај"

#: lib/potok_ide_web/domain_copy.ex:601
#, elixir-autogen, elixir-format
