<%!-- The group takes the screen: one bar of its own instead of the landing's
 header, the rest in that bar's menu, and an app under it as far as the
 screen goes, the only thing that scrolls. --%>
<Layouts.guest
  flash={@flash}
  current_locale={@current_locale}
  available_locales={@available_locales}
  fill={@guest.app_session != nil}
>
  <:bar>
    <div class="flex items-center gap-2.5 py-2 pr-2 pl-4 sm:pr-3 sm:pl-6">
      <img
        id="guest-bar-image"
        src={PotokIdeWeb.Avatars.group_avatar_url(@guest.group)}
        alt=""
        class="size-9 shrink-0 rounded-full border border-base-300 bg-base-100 object-cover"
      />
      <div class="min-w-0 flex-1">
        <h1 id="guest-bar-name" class="truncate text-[0.9375rem] leading-5 font-semibold">
          {@guest.group.name}
        </h1>
        <p class="flex min-w-0 items-center gap-1 text-xs leading-4 text-base-content/65">
          <Layouts.mark id="guest-bar-mark" class="size-3.5 shrink-0" />
          <span class="truncate">
            {gettext("Public group")} · <span class="font-brand font-bold">potok</span>
          </span>
        </p>
      </div>
      <.link
        id="guest-bar-login"
        href={~p"/accounts/log-in"}
        class="lp-button-quiet shrink-0 gap-1.5 px-3.5 py-1.5 text-sm"
      >
        <.icon :if={@guest.app_session} name="hero-shield-check-mini" class="size-4" />
        {gettext("Log in")}
      </.link>
      <button
        id="guest-menu-button"
        type="button"
        popovertarget="guest-menu"
        aria-label={gettext("Open menu")}
        title={gettext("Open menu")}
        class="inline-flex size-10 shrink-0 items-center justify-center rounded-full text-base-content/70 transition duration-150 hover:bg-base-content/5 hover:text-base-content focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none active:scale-95"
      >
        <.icon name="hero-bars-3" class="size-5" />
      </button>
    </div>

    <%!-- A popover: the top layer without a script, closed by a tap beside it. --%>
    <div
      id="guest-menu"
      popover
      role="dialog"
      aria-labelledby="guest-menu-title"
      class="lp-sheet"
    >
      <header class="flex items-center gap-2.5 pt-3 pr-3 pb-2 pl-5">
        <Layouts.mark id="guest-menu-mark" class="size-7 shrink-0" />
        <p id="guest-menu-title" class="min-w-0 flex-1 font-brand text-lg font-bold">potok</p>
        <button
          id="guest-menu-close"
          type="button"
          popovertarget="guest-menu"
          popovertargetaction="hide"
          aria-label={gettext("Close")}
          title={gettext("Close")}
          class="inline-flex size-10 shrink-0 items-center justify-center rounded-full text-base-content/70 transition duration-150 hover:bg-base-content/5 hover:text-base-content focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:outline-none active:scale-95"
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </header>

      <div class="flex flex-col gap-1 px-3 pb-3">
        <p :if={@guest.app_session} id="guest-menu-app-note" class="lp-note mx-1 mb-2">
          <.icon name="hero-shield-check" class="mt-1 size-4 shrink-0 text-(--lp-accent)" />
          <span>
            {gettext(
              "The group made this app. Potok never asks for your password inside an app: log in only with the button at the top."
            )}
          </span>
        </p>
        <.link id="guest-menu-about" href={~p"/"} class="lp-sheet-row">
          <.icon name="hero-sparkles" class="size-5 shrink-0 text-base-content/55" />
          {gettext("What is Potok?")}
        </.link>
        <.link id="guest-menu-invitation" href={~p"/" <> "#landing-join"} class="lp-sheet-row">
          <.icon name="hero-envelope" class="size-5 shrink-0 text-base-content/55" />
          <span class="min-w-0">
            <span class="block">{gettext("No account yet?")}</span>
            <span class="block text-xs font-normal text-base-content/65">
              {gettext("Potok is invitation only for now.")}
            </span>
          </span>
        </.link>
      </div>

      <div class="flex flex-col items-center gap-3 border-t border-base-content/8 px-5 pt-4">
        <Layouts.locale_switcher
          current_locale={@current_locale}
          available_locales={@available_locales}
        />
        <Layouts.theme_toggle />
      </div>

      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 px-5 pt-4 text-sm text-base-content/65">
        <.link id="guest-menu-help" href={~p"/pomoc"} class="underline-offset-4 hover:underline">
          {gettext("Help")}
        </.link>
        <.link id="guest-menu-terms" href={~p"/terms"} class="underline-offset-4 hover:underline">
          {gettext("Terms of use")}
        </.link>
        <.link
          id="guest-menu-privacy"
          href={~p"/privacy-policy"}
          class="underline-offset-4 hover:underline"
        >
          {gettext("Privacy policy")}
        </.link>
      </div>
    </div>
  </:bar>

  <div
    id="guest-group"
    class={[
      "flex flex-col",
      if(@guest.app_session,
        do: "min-h-0 flex-1",
        else: "mx-auto w-full max-w-5xl px-4 pt-4 pb-12 sm:px-8 sm:pt-8"
      )
    ]}
  >
    <nav
      :if={length(@guest.entries) > 1}
      id="guest-descriptions"
      aria-label={gettext("Descriptions")}
      class={[
        "lp-rise flex gap-2 overflow-x-auto [scrollbar-width:none]",
        if(@guest.app_session,
          do: "shrink-0 px-4 py-2 sm:px-6",
          else: "-mx-4 px-4 pb-3 sm:mx-0 sm:px-0 sm:pb-4"
        )
      ]}
    >
      <a
        :for={entry <- @guest.entries}
        id={"guest-description-link-#{entry.id || "default"}"}
        href={GuestDescriptions.path(@guest.group, entry)}
        aria-current={if(entry == @guest.entry, do: "page")}
        class={["lp-chip", entry == @guest.entry && "is-active"]}
      >
        <.icon :if={entry.uses_api} name="hero-squares-2x2-mini" class="size-3.5 opacity-70" />
        <span class="truncate">{entry.name}</span>
      </a>
    </nav>

    <%= if @guest.app_session do %>
      <%!-- The app has the screen under the bar, edge to edge; the word
       about passwords is in the bar's menu. --%>
      <section
        id="guest-app"
        class={[
          "lp-app-box lp-rise",
          length(@guest.entries) > 1 && "border-t border-(--lp-line)"
        ]}
      >
        {live_render(@conn, PotokIdeWeb.GroupLive.GuestApp,
          session: @guest.app_session,
          container: {:div, class: "flex min-h-0 flex-1 flex-col"}
        )}
      </section>
    <% else %>
      <article
        id="guest-description"
        class={["lp-rise", GroupDescriptionTab.description_column(@guest.source) || "w-full"]}
      >
        <Components.formatted_content
          content={@guest.source.description}
          content_format={@guest.source.description_format}
        />
      </article>
    <% end %>

    <section
      :if={!@guest.app_session}
      id="guest-join"
      class="lp-note lp-rise mt-12 flex-col gap-4 p-5! sm:flex-row sm:items-center"
    >
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-base-content">
          {gettext("This is a public group on Potok.")}
        </p>
        <p class="mt-1">{gettext("Log in to see its chat and members, and to take part.")}</p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <.link id="guest-join-login" href={~p"/accounts/log-in"} class="lp-button group">
          {gettext("Log in")}
          <.icon
            name="hero-arrow-right"
            class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </.link>
        <.link id="guest-join-about" href={~p"/"} class="lp-link text-sm">
          {gettext("What is Potok?")}
        </.link>
      </div>
    </section>
    <p
      :if={!@guest.app_session}
      id="guest-join-invitation-note"
      class="mt-3 text-sm leading-6 text-base-content/65"
    >
      {gettext("No account yet?")}
      <.link href={~p"/" <> "#landing-join"} class="lp-link">
        {gettext("Potok is invitation only for now.")}
      </.link>
    </p>
  </div>
</Layouts.guest>
