  {
    "name": "glasanje-detalji",
    "as": "ana",
    "url": "/groups/{groups.mz_zbor}/polls",
    "steps": [{ "click": "#polls-list a, #polls-list [phx-click]" }, { "pause": 800 }]
  },
  {
    "name": "mapa-grupa",
