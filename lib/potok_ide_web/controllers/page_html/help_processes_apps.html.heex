          </text>
          <text class="hg-t-sub" x="800" y="51" text-anchor="middle">
            {dgettext("help_guides", "a drawn process")}
          </text>
          <rect class="hg-hd hg-hd-proc" x="915" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row hg-f-proc" x="985" y="35" text-anchor="middle">
