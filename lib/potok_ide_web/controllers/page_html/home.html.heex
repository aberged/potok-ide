<Layouts.guest
  flash={@flash}
  current_locale={@current_locale}
  available_locales={@available_locales}
>
  <:header_action>
    <.link
      id="landing-login-link"
      href={~p"/accounts/log-in"}
      class="rounded-full border border-base-content/15 px-4 py-2 text-sm font-medium transition duration-200 hover:border-base-content/30 hover:bg-base-content/5 active:scale-[0.98]"
    >
      {gettext("Log in")}
    </.link>
  </:header_action>

  <div class="mx-auto max-w-5xl px-5 pt-2 sm:px-8 sm:pt-4">
    <section id="landing-hero" class="lp-hero">
      <Layouts.mark id="landing-hero-mark" class="lp-watermark" />
      <div class="lp-hero-body">
        <h1>{gettext("Society for society")}</h1>
        <p class="lp-lead">
          {gettext(
            "Conversations, events, files, roles, notifications, groups, sub-groups and apps. On your computer and on your phone."
          )}
        </p>
        <ul class="lp-pills">
          <li :for={
            pill <- [
              gettext("Chat"),
              gettext("Calendar"),
              gettext("Files"),
              gettext("Roles"),
              gettext("Apps")
            ]
          }>
            {pill}
          </li>
        </ul>
      </div>
    </section>
  </div>

  <%!-- Each strip holds the same wave twice and slides by half its width,
           so the loop has no seam. --%>
  <div
    id="landing-waves"
    class="lp-waves relative h-24 overflow-hidden sm:h-32"
    aria-hidden="true"
  >
    <div
      :for={
        {wave, d} <- [
          {"lp-wave-a", "M0 50 C200 85 400 15 600 50 C800 85 1000 15 1200 50"},
          {"lp-wave-b", "M0 60 C150 30 450 90 600 60 C750 30 1050 90 1200 60"},
          {"lp-wave-c", "M0 45 C250 70 350 20 600 45 C850 70 950 20 1200 45"}
        ]
      }
      class={["lp-drift absolute inset-0 flex w-[200%]", wave]}
    >
      <svg
        :for={_ <- 1..2}
        viewBox="0 0 1200 100"
        preserveAspectRatio="none"
        class="h-full w-1/2"
      >
        <path d={d} fill="none" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-5 pb-16 sm:px-8 sm:pb-24">
    <section id="landing-features" class="lp-section">
      <p class="lp-kicker">{gettext("What Potok can do")}</p>
      <h2>
        {gettext(
          "Potok can think of values as arising in groups, and of groups as arising from values."
        )}
      </h2>

      <div class="lp-grid">
        <article
          :for={feature <- features()}
          id={"landing-feature-#{feature.id}"}
          class="lp-feature"
        >
          <div class="lp-icon"><.icon name={feature.icon} class="size-6" /></div>
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </article>
      </div>
    </section>

    <section id="landing-perks" class="lp-section">
      <p class="lp-kicker">{gettext("Always with you")}</p>
      <ul class="lp-perks">
        <li :for={perk <- perks()} id={"landing-perk-#{perk.id}"}>
          <span class="lp-icon"><.icon name={perk.icon} class="size-5" /></span>
          <div>
            <strong>{perk.title}</strong>
            <span>{perk.text}</span>
          </div>
        </li>
      </ul>
    </section>

    <section id="landing-join" class="lp-cta scroll-mt-6">
      <h2>{gettext("For now, Potok is by invitation only.")}</h2>
      <p>{gettext("Know someone who could use it? Send them an invitation by email.")}</p>
      <.link id="landing-join-login" href={~p"/accounts/log-in"} class="lp-button group mt-6">
        {gettext("Log in")}
        <.icon
          name="hero-arrow-right"
          class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </.link>
    </section>

    <section id="landing-origin" class="lp-section">
      <p class="lp-kicker">{gettext("Where Potok springs from")}</p>
      <div class="lp-origin">
        <div>
          <h2>{gettext("Eighteen springs, one stream.")}</h2>
          <p>{origin_lead()}</p>
          <.link id="landing-origin-link" href={~p"/origin"} class="lp-domain-link group">
            {gettext("Read the overview (in Serbian)")}
            <.icon
              name="hero-arrow-right"
              class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </.link>
        </div>
        <.origin_springs />
      </div>
    </section>

    <section id="landing-domain" class="lp-section">
      <p class="lp-kicker">{gettext("Under the surface")}</p>
      <div class="lp-domain">
        <div>
          <h2>{gettext("Simple, but not shallow.")}</h2>
          <p>
            {gettext(
              "Profiles, groups, values, roles, reactions, threads, events, descriptions and apps are all entities of the domain model of the social application network that Potok implements."
            )}
          </p>
          <.link id="landing-domain-link" href={~p"/domain"} class="lp-domain-link group">
            {gettext("See the domain map")}
            <.icon
              name="hero-arrow-right"
              class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </.link>
        </div>
        <.domain_loop />
      </div>
    </section>
  </div>
</Layouts.guest>
