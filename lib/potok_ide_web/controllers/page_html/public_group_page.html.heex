<Layouts.guest
  flash={@flash}
  current_locale={@current_locale}
  available_locales={@available_locales}
>
  <:header_action>
    <.link
      id="guest-group-login"
      href={~p"/accounts/log-in"}
      class="lp-button-quiet px-4 py-2 text-sm"
    >
      {gettext("Log in")}
    </.link>
  </:header_action>

  <div id="guest-group" class="mx-auto flex w-full max-w-5xl flex-col px-5 pb-12 sm:px-8">
    <header id="guest-group-header" class="lp-rise flex items-center gap-4 pb-5">
      <img
        id="guest-group-image"
        src={PotokIdeWeb.Avatars.group_avatar_url(@guest.group)}
        alt=""
        class="size-14 shrink-0 rounded-full border border-base-300 bg-base-100 object-cover shadow-sm sm:size-16"
      />
      <div class="min-w-0">
        <p class="lp-kicker">{gettext("Public group")}</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-balance wrap-break-word sm:text-3xl">
          {@guest.group.name}
        </h1>
      </div>
    </header>

    <nav
      :if={length(@guest.entries) > 1}
      id="guest-descriptions"
      aria-label={gettext("Descriptions")}
      class="lp-rise -mx-5 flex gap-2 overflow-x-auto px-5 pt-1 pb-4 [scrollbar-width:none] sm:mx-0 sm:px-0"
    >
      <a
        :for={entry <- @guest.entries}
        id={"guest-description-link-#{entry.id || "default"}"}
        href={GuestDescriptions.path(@guest.group, entry)}
        aria-current={if(entry == @guest.entry, do: "page")}
        class={["lp-chip", entry == @guest.entry && "is-active"]}
      >
        <.icon :if={entry.uses_api} name="hero-squares-2x2-mini" class="size-3.5 opacity-70" />
        <span class="truncate">{entry.name}</span>
      </a>
    </nav>

    <%= if @guest.app_session do %>
      <section id="guest-app" class="lp-app-box lp-rise">
        {live_render(@conn, PotokIdeWeb.GroupLive.GuestApp,
          session: @guest.app_session,
          container: {:div, class: "flex min-h-0 flex-1 flex-col"}
        )}
      </section>
      <p
        id="guest-app-note"
        class="mt-3 flex items-start gap-2 text-xs leading-5 text-base-content/65"
      >
        <.icon name="hero-shield-check" class="mt-0.5 size-4 shrink-0" />
        <span>
          {gettext(
            "The group made this app. Potok never asks for your password inside an app: log in only with the button at the top."
          )}
        </span>
      </p>
    <% else %>
      <article
        id="guest-description"
        class={["lp-rise", GroupDescriptionTab.description_column(@guest.source) || "w-full"]}
      >
        <Components.formatted_content
          content={@guest.source.description}
          content_format={@guest.source.description_format}
        />
      </article>
    <% end %>

    <section
      id="guest-join"
      class="lp-note lp-rise mt-12 flex-col gap-4 p-5! sm:flex-row sm:items-center"
    >
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-base-content">
          {gettext("This is a public group on Potok.")}
        </p>
        <p class="mt-1">{gettext("Log in to see its chat and members, and to take part.")}</p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-4">
        <.link id="guest-join-login" href={~p"/accounts/log-in"} class="lp-button group">
          {gettext("Log in")}
          <.icon
            name="hero-arrow-right"
            class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </.link>
        <.link id="guest-join-about" href={~p"/"} class="lp-link text-sm">
          {gettext("What is Potok?")}
        </.link>
      </div>
    </section>
    <p id="guest-join-invitation-note" class="mt-3 text-sm leading-6 text-base-content/65">
      {gettext("No account yet?")}
      <.link href={~p"/" <> "#landing-join"} class="lp-link">
        {gettext("Potok is invitation only for now.")}
      </.link>
    </p>
  </div>
</Layouts.guest>
