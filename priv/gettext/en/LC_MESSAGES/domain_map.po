msgstr ""

#: lib/potok_ide_web/domain_copy.ex:518
#, elixir-autogen, elixir-format
msgid "the HTML its fields go into"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:515
#, elixir-autogen, elixir-format
msgid "the fields of its form"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:521
#, elixir-autogen, elixir-format
msgid "version, which a description keeps"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:514
#, elixir-autogen, elixir-format
