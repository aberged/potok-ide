<!DOCTYPE html>
<html lang={assigns[:current_locale] || PotokIdeWeb.Locale.default_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="PotokIde" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(232,104,86,0.14),_transparent_40%),linear-gradient(180deg,_transparent,_rgba(0,0,0,0.03))] text-base-content">
    <div class="relative min-h-screen">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-primary/10 via-transparent to-transparent">
      </div>

      <nav class="sticky top-0 z-20 px-4 pb-3 pt-4 sm:px-6 lg:px-8">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-[2rem] border border-base-300/70 bg-base-100/85 px-4 py-3 shadow-lg shadow-primary/5 backdrop-blur sm:px-5">
          <% profile = assigns[:current_profile] %>
          <% profile_picture_url =
            if profile && is_binary(profile.profile_picture_url) do
              case String.trim(profile.profile_picture_url) do
                "" -> nil
                trimmed_url -> trimmed_url
              end
            end %>
          <% profile_initials =
            if profile do
              profile.username
              |> to_string()
              |> String.split(~r/[\s_-]+/, trim: true)
              |> Enum.take(2)
              |> Enum.map_join(fn part ->
                part
                |> String.first()
                |> to_string()
              end)
              |> case do
                "" -> "?"
                initials -> String.upcase(initials)
              end
            end %>

          <.link href={~p"/"} class="flex min-w-0 items-center gap-3 self-start">
            <span class="flex size-10 items-center justify-center rounded-2xl border border-base-300 bg-gradient-to-br from-primary/15 via-base-100 to-secondary/10 shadow-sm">
              <img
                id="nav-brand-profile-avatar"
                src={profile_picture_url || ~p"/images/logo.svg"}
                alt={if(profile, do: profile.username, else: "PotokIde")}
                class={[
                  "size-10 rounded-2xl object-cover",
                  is_nil(profile_picture_url) && "hidden"
                ]}
              />
              <span
                id="nav-brand-profile-initials"
                class={[
                  "flex size-10 items-center justify-center rounded-2xl text-sm font-semibold uppercase text-base-content/75",
                  (is_nil(profile) or !is_nil(profile_picture_url)) && "hidden"
                ]}
              >
                {profile_initials}
              </span>
              <img
                id="nav-brand-logo"
                src={~p"/images/logo.svg"}
                width="24"
                alt="PotokIde"
                class={[!is_nil(profile) && "hidden"]}
              />
            </span>
            <span class="min-w-0">
              <span class="block text-xs font-semibold uppercase tracking-[0.18em] text-base-content/55">
                PotokIde
              </span>
              <span
                id="nav-brand-title"
                data-default-title="[page title]"
                class="block truncate text-sm font-semibold text-base-content"
              >
                <%= if profile do %>
                  {profile.username}
                <% else %>
                  [page title]
                <% end %>
              </span>
            </span>
          </.link>

          <.header_menu>
            <%= if @current_scope do %>
              <div class="mb-4 max-w-full truncate rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium text-base-content/70">
                {@current_scope.account.email}
              </div>

              <div
                id="nav-selected-profile-card"
                class="mb-4 rounded-2xl border border-base-300 bg-base-200/70 px-4 py-3 text-sm text-base-content/75"
                hidden={is_nil(profile)}
              >
                <div class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">
                  {gettext("Selected profile")}
                </div>
                <div
                  id="nav-selected-profile-name"
                  class="mt-1 truncate font-medium text-base-content"
                >
                  {if(profile, do: profile.username, else: nil)}
                </div>
              </div>
            <% end %>

            <div class="flex flex-col gap-2">
              <%= if @current_scope do %>
                <.link
                  href={~p"/profiles"}
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Profiles")}
                </.link>
                <.link
                  href={~p"/groups"}
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Groups")}
                </.link>
                <.link
                  href={~p"/invitations"}
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Invitations")}
                </.link>
                <.link
                  href={~p"/accounts/settings"}
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Settings")}
                </.link>
                <.link
                  href={~p"/accounts/log-out"}
                  method="delete"
                  class="rounded-2xl bg-base-content px-4 py-3 text-sm font-medium text-base-100 transition-opacity hover:opacity-90"
                >
                  {gettext("Log out")}
                </.link>
              <% else %>
                <.link
                  href={~p"/accounts/register"}
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Register")}
                </.link>
                <.link
                  href={~p"/accounts/log-in"}
                  class="rounded-2xl bg-base-content px-4 py-3 text-sm font-medium text-base-100 transition-opacity hover:opacity-90"
                >
                  {gettext("Log in")}
                </.link>
              <% end %>
            </div>

            <%!-- <div class="mt-4 border-t border-base-300/70 pt-4">
              <div class="flex flex-col gap-2">
                <a
                  href="https://phoenixframework.org/"
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("Website")}
                </a>
                <a
                  href="https://github.com/phoenixframework/phoenix"
                  class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm font-medium transition-colors hover:bg-base-300"
                >
                  {gettext("GitHub")}
                </a>
                <a
                  href="https://hexdocs.pm/phoenix/overview.html"
                  class="rounded-2xl bg-base-content px-4 py-3 text-sm font-medium text-base-100 transition-opacity hover:opacity-90"
                >
                  {gettext("Get Started")} <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div> --%>

            <div class="mt-4 border-t border-base-300/70 pt-4">
              <.locale_switcher
                current_locale={assigns[:current_locale]}
                available_locales={assigns[:available_locales]}
              />
            </div>

            <div class="mt-4 border-t border-base-300/70 pt-4">
              <.theme_toggle />
            </div>
          </.header_menu>
        </div>
      </nav>

      <div class="relative z-0">
        {@inner_content}
      </div>
    </div>
  </body>
</html>
