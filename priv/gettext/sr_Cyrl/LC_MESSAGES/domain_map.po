msgstr "Интервал понављања је од 1 до 99."

#: lib/potok_ide_web/domain_copy.ex:973
#, elixir-autogen, elixir-format
msgid "The role `everyone` is not written here."
msgstr "Улога `everyone` се не уписује."

#: lib/potok_ide_web/domain_copy.ex:935
#, elixir-autogen, elixir-format
msgid "The root and direct groups do not inherit members."
msgstr "Корен и директне групе не наслеђују чланове."

#: lib/potok_ide_web/domain_copy.ex:927
#, elixir-autogen, elixir-format
msgid "The root has no creator, every other group does."
msgstr "Корен нема аутора, а свака друга група има."

