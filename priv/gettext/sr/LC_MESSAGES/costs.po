msgstr "Izaberi mesec računa."

#: lib/potok_ide_web/controllers/hosting_cost_html/index.html.heex:75
#, elixir-autogen, elixir-format
msgid "Potok does not estimate its costs here, as it cannot read Fly. Billed months still show below."
msgstr "Potok ovde ne procenjuje troškove jer ne može da čita Fly. Naplaćeni meseci su ipak ispod."

#: lib/potok_ide_web/controllers/hosting_cost_html/index.html.heex:209
#, elixir-autogen, elixir-format
msgid "Potok has estimated since %{date}; earlier months show only their invoices."
msgstr "Potok procenjuje od %{date}, a raniji meseci imaju samo račune."

#: lib/potok_ide_web/controllers/hosting_cost_html.ex:14
#, elixir-autogen, elixir-format
msgid "Potok runs on Fly.io and pays for it every month, in US dollars. Fly gives no way to read its bills, so Potok estimates them itself every quarter of an hour, from what runs and Fly's price list. Once a month is billed, the real sum stands next to the estimate."
msgstr "Potok radi na Fly.io i plaća ga svakog meseca, u američkim dolarima. Fly ne daje način da se pročitaju njegovi računi, pa ih Potok sam procenjuje na svakih petnaest minuta, iz onoga što radi i Fly-ovog cenovnika. Kad mesec bude naplaćen, pravi iznos stoji pored procene."

