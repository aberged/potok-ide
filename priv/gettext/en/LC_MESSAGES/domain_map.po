#: lib/potok_ide_web/domain_copy.ex:813
#, elixir-autogen, elixir-format
msgid "It can list the <Group>groups</Group> under one of its sub-groups, all of them or those of a chosen period, show their descriptions and take the viewer to their chat or their page. A link can open it on one of those groups. That is how a group becomes a news feed, with one story in each group."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:811
#, elixir-autogen, elixir-format
msgid "Reads the groups below it"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:831
#, elixir-autogen, elixir-format
msgid "For a viewer who may edit its group, an app can make <Group>groups</Group> right under it, change them and take them back. That is how one app writes what another shows, and a feed gets its editors' desk."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:897
#, elixir-autogen, elixir-format
msgid "It writes to groups only for a viewer who may edit its own group, only right under it, and it neither deletes a group nor makes one an app."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:829
#, elixir-autogen, elixir-format
msgid "Keeps the groups below it"
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:185
