#: lib/potok_ide_web/domain_copy.ex:702
#, elixir-autogen, elixir-format
msgid "Group and roles"
msgstr "Grupa i uloge"

#: lib/potok_ide_web/domain_copy.ex:750
#, elixir-autogen, elixir-format
msgid "Group invitation"
msgstr "Pozivnica u grupu"

#: lib/potok_ide_web/domain_copy.ex:907
#, elixir-autogen, elixir-format
msgid "How far a profile has read a group. Everything newer than the last read value is unread. That value is kept as a plain number, with no foreign key."
msgstr "Dokle je profil pročitao grupu. Nepročitano je sve novije od poslednje pročitane vrednosti. Ta vrednost je zapisana kao običan broj, bez spoljnog ključa."

#: lib/potok_ide_web/domain_copy.ex:1823
#, elixir-autogen, elixir-format
msgid "How permissions come about"
msgstr "Kako nastaju dozvole"

#: lib/potok_ide_web/domain_copy.ex:2107
#, elixir-autogen, elixir-format
msgid "How to get into a group"
msgstr "Kako se ulazi u grupu"

#: lib/potok_ide_web/domain_copy.ex:1672
#, elixir-autogen, elixir-format
msgid "It follows the light or dark theme, and keeps each viewer's settings in their browser."
msgstr "Prati svetlu ili tamnu temu, a podešavanja gledaoca čuva u njegovom pregledaču."

#: lib/potok_ide_web/domain_copy.ex:1645
#, elixir-autogen, elixir-format
msgid "It gets the viewer's <Profile>profile</Profile> and their <GroupRole>roles</GroupRole> in the group, so it can show different things to different members. Of the profile's <ProfileField>details</ProfileField> and description it gets only what the group's members see, never what the profile keeps for itself."
msgstr "Dobija <Profile>profil</Profile> gledaoca i njegove <GroupRole>uloge</GroupRole> u grupi, pa različitim članovima može da pokaže različite stvari. Od <ProfileField>detalja</ProfileField> i opisa profila dobija samo ono što vide članovi grupe, a nikad ono što profil čuva za sebe."

#: lib/potok_ide_web/domain_copy.ex:753
#, elixir-autogen, elixir-format
msgid "Join request"
msgstr "Zahtev za ulazak"

#: lib/potok_ide_web/domain_copy.ex:708
#, elixir-autogen, elixir-format
msgid "Joining a group"
msgstr "Ulazak u grupu"

#: lib/potok_ide_web/domain_copy.ex:1553
#, elixir-autogen, elixir-format
msgid "Keeps its own data"
msgstr "Čuva svoje podatke"

#: lib/potok_ide_web/domain_copy.ex:1416
#, elixir-autogen, elixir-format
msgid "Keys of this table"
msgstr "Ključevi ove tabele"

#: lib/potok_ide_web/domain_copy.ex:1514
#, elixir-autogen, elixir-format
msgid "Keys that block deleting"
msgstr "Ključevi koji blokiraju brisanje"

#: lib/potok_ide_web/domain_copy.ex:1643
#, elixir-autogen, elixir-format
msgid "Knows who is looking"
msgstr "Zna ko je gleda"

#: lib/potok_ide_web/domain_copy.ex:720
#, elixir-autogen, elixir-format
msgid "Manifest"
msgstr "Manifest"

#: lib/potok_ide_web/domain_copy.ex:723
#, elixir-autogen, elixir-format
msgid "Member role"
msgstr "Uloga člana"

#: lib/potok_ide_web/domain_copy.ex:1927
#, elixir-autogen, elixir-format
