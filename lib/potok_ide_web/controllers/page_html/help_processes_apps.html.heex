            x1="610"
            y1="378"
            x2="410"
            y2="378"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-mono hg-f-potok" x="510" y="372" text-anchor="middle">onWaiting</text>
          <line
            class="hg-ar hg-s-fg"
            x1="240"
            y1="412"
            x2="410"
            y2="412"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="325" y="406" text-anchor="middle">
            {dgettext("help_guides", "“Calling a repairer”")}
          </text>
          <line
            class="hg-ar hg-s-app"
            x1="410"
            y1="446"
            x2="610"
            y2="446"
            marker-end="url(#hg-m-app)"
          />
          <text class="hg-t-mono hg-f-app" x="510" y="440" text-anchor="middle">
            completeTask
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="610"
            y1="480"
            x2="795"
            y2="480"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="702" y="474" text-anchor="middle">
            {dgettext("help_guides", "the decision's outcome")}
          </text>

          <line
            class="hg-ar hg-s-proc"
            x1="805"
            y1="540"
            x2="980"
            y2="540"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="892" y="534" text-anchor="middle">
            {dgettext("help_guides", "call: fault, deadline 7 days")}
          </text>
          <line
            class="hg-ar hg-s-proc"
            x1="980"
            y1="574"
            x2="610"
            y2="574"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="892" y="568" text-anchor="middle">
            {dgettext("help_guides", "a decision on the Processes tab")}
          </text>
          <line
            class="hg-ar hg-s-fg"
            x1="240"
            y1="608"
            x2="610"
            y2="608"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="510" y="602" text-anchor="middle">
