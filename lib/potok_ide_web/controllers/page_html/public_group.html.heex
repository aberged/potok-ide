<Layouts.guest
  flash={@flash}
  current_locale={@current_locale}
  available_locales={@available_locales}
  centered
  about_link
>
  <Layouts.guest_card
    id="public-group"
    title={@group.name}
    subtitle={@page_description}
    image={PotokIdeWeb.Avatars.group_avatar_url(@group)}
    invitation_note
  >
    <.link
      id="public-group-login"
      href={~p"/accounts/log-in"}
      class="lp-button group w-full justify-center"
    >
      {gettext("Log in")}
      <.icon
        name="hero-arrow-right"
        class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    </.link>
  </Layouts.guest_card>
</Layouts.guest>
