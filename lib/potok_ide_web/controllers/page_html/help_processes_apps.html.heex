          </text>
          <text class="hg-t-phase hg-halo" x="14" y="318">
            {dgettext("help_guides", "2 · The manager picks an outcome in the app")}
          </text>
          <text class="hg-t-phase hg-halo" x="14" y="514">
            {dgettext("help_guides", "3 · The report calls the Repairer and waits")}
          </text>
          <text class="hg-t-phase hg-halo" x="14" y="710">
            {dgettext("help_guides", "4 · Everyone in the sub-group finds out")}
          </text>

          <rect class="hg-act-run" x="795" y="250" width="10" height="94" />
