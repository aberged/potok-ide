            y1="216"
            x2="610"
            y2="216"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="325" y="210" text-anchor="middle">
            {dgettext("help_guides", "the fault's title and description")}
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="610"
            y1="250"
            x2="795"
            y2="250"
            marker-end="url(#hg-m-potok)"
