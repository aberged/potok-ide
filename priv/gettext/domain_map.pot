#: lib/potok_ide_web/domain_copy.ex:545
#, elixir-autogen, elixir-format
msgid "An additional description of a group next to the default one. Like it, it can be text or an app with its own data. It can be limited to certain roles, and without a limit everyone who sees the group's description sees it."
msgstr ""

#: lib/potok_ide_web/domain_copy.ex:1023
