{
  "id": "/",
  "name": "Potok",
  "short_name": "Potok",
  "description": "Potok keeps your profiles, groups, and values available in an installable web app.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f8fa",
  "theme_color": "#4ba8c0",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/images/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/images/pwa/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}