<%!--
  The help's page on who talks to whom between an app, a group and the processes. It describes the code:
  see `PotokIdeWeb.HelpGuides` before changing it, and when the code it was
  drawn from changes (`watch` there, which `mix potok.sync_reminder` follows).
--%>
<.help_guide_frame
  guide={@guide}
  flash={@flash}
  current_scope={@current_scope}
  current_locale={@current_locale}
  available_locales={@available_locales}
>
  <section class="hg-section" aria-label={dgettext("help_guides", "Who is who")}>
    <div class="hg-keys">
      <div class="hg-key hg-key-potok">
        <h3>{dgettext("help_guides", "Potok")}</h3>
        <p>
          {dgettext(
            "help_guides",
            "Groups in a tree, members and roles, values. A message in a chat is a value, an app's piece of data is a value, and a thread is a group again. Permissions come from the manifest of the group or of its nearest ancestor."
          )}
        </p>
      </div>
      <div class="hg-key hg-key-app">
        <h3>{dgettext("help_guides", "App")}</h3>
        <p>
          <.hg_text text={
            dgettext(
              "help_guides",
              "HTML in a group's description, the default or an alternative one. It runs at the viewer's, in a frame that does not see Potok's page, and talks to Potok only through the App API. It is made, say, from the `potok-vite` template."
            )
          } />
        </p>
      </div>
      <div class="hg-key hg-key-proc">
        <h3>{dgettext("help_guides", "Process")}</h3>
        <p>
          {dgettext(
            "help_guides",
            "A drawing with a trigger, steps and ends. The group's editors draw it on the Processes tab, and an app can carry one of its own, in the rule of a collection. It runs on the server, under a profile of its own that belongs to no account."
          )}
        </p>
      </div>
      <div class="hg-key hg-key-wait">
        <h3>{dgettext("help_guides", "Waiting for a person")}</h3>
        <p>
          {dgettext(
            "help_guides",
            "An instance of a process stands at a form or a decision until someone answers. That is where the number on the hand in the bar (Requests), the “Waiting for you” button in the group's header and the yellow mark on the rows of groups come from."
          )}
        </p>
      </div>
    </div>
  </section>

  <section class="hg-section">
    <h2>{dgettext("help_guides", "Who talks to whom")}</h2>
    <figure id="hg-fig-flow" class="hg-fig" style="--hg-min: 900px">
      <div class="hg-swipe">{dgettext("help_guides", "The picture scrolls left and right.")}</div>
      <div class="hg-scroll">
        <svg
          viewBox="0 0 1200 690"
          role="img"
          aria-label={
            dgettext(
              "help_guides",
              "Three columns: the app in the browser, the group in Potok and the processes on the server. Every link of the app and of the processes with the group goes through the check of permissions, and the app and a process never see each other directly."
            )
          }
        >
          <rect class="hg-server" x="384" y="96" width="804" height="580" rx="16" />
          <text class="hg-t-lab hg-f-muted" x="400" y="667">
            {dgettext("help_guides", "Potok's server")}
          </text>
          <text class="hg-t-lab hg-f-muted" x="24" y="667">
            {dgettext("help_guides", "the viewer's browser")}
          </text>

          <rect class="hg-people" x="24" y="20" width="1152" height="44" rx="10" />
          <text class="hg-t-row" x="44" y="47">{dgettext("help_guides", "People")}</text>
          <text class="hg-t-sub" x="92" y="47">
            {dgettext(
              "help_guides",
              "members of the group; a guest only reads, where the group is public"
            )}
          </text>
          <line
            class="hg-ar hg-s-fg"
            x1="164"
            y1="64"
            x2="164"
            y2="118"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="172" y="95">{dgettext("help_guides", "uses the app")}</text>
          <line
            class="hg-ar hg-s-fg"
            x1="584"
            y1="64"
            x2="584"
            y2="118"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="592" y="95">
            {dgettext("help_guides", "writes, votes, makes sub-groups")}
          </text>
          <line
            class="hg-ar hg-s-fg"
            x1="890"
            y1="64"
            x2="890"
            y2="118"
            marker-end="url(#hg-m-fg)"
          />
          <text class="hg-t-lab" x="898" y="95">
            {dgettext("help_guides", "Start, form, outcome")}
          </text>
          <line
            class="hg-ar hg-s-wait"
            x1="1152"
            y1="120"
            x2="1152"
            y2="66"
            marker-end="url(#hg-m-wait)"
          />
          <text class="hg-t-lab hg-f-wait-ink" x="1144" y="95" text-anchor="end">
            {dgettext("help_guides", "push, “Waiting for you”")}
          </text>

          <rect class="hg-col hg-col-app" x="24" y="120" width="280" height="520" rx="12" />
          <rect class="hg-col hg-col-potok" x="424" y="120" width="320" height="520" rx="12" />
          <rect class="hg-col hg-col-proc" x="864" y="120" width="312" height="520" rx="12" />

          <text class="hg-t-title hg-f-app" x="44" y="152">{dgettext("help_guides", "App")}</text>
          <text class="hg-t-sub" x="44" y="170">
            {dgettext("help_guides", "HTML in a group's description, in its own frame")}
          </text>
          <text class="hg-t-title hg-f-potok" x="584" y="152" text-anchor="middle">
            {dgettext("help_guides", "The group in Potok")}
          </text>
          <text class="hg-t-sub" x="584" y="170" text-anchor="middle">
            {dgettext("help_guides", "permissions from the group's manifest")}
          </text>
          <text class="hg-t-title hg-f-proc" x="884" y="152">
            {dgettext("help_guides", "Processes")}
          </text>
          <text class="hg-t-sub" x="884" y="170">
            {dgettext("help_guides", "on the server, under their own profile")}
          </text>

          <rect class="hg-band" x="436" y="184" width="18" height="400" rx="4" />
          <rect class="hg-band" x="714" y="184" width="18" height="400" rx="4" />
          <text
            class="hg-t-band"
            transform="translate(448.5 384) rotate(-90)"
            text-anchor="middle"
          >
            {dgettext("help_guides", "PERMISSION CHECK")}
          </text>
          <text
            class="hg-t-band"
            transform="translate(726.5 384) rotate(-90)"
            text-anchor="middle"
          >
            {dgettext("help_guides", "PERMISSION CHECK")}
          </text>

          <rect class="hg-row-potok" x="464" y="190" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="213">{dgettext("help_guides", "App data")}</text>
          <text class="hg-t-sub" x="478" y="230">
            {dgettext("help_guides", "values by collections, under rules")}
          </text>

          <rect class="hg-row-potok" x="464" y="256" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="279">{dgettext("help_guides", "Chat")}</text>
          <text class="hg-t-sub" x="478" y="296">
            {dgettext("help_guides", "messages are values, threads are groups")}
          </text>

          <rect class="hg-row-potok" x="464" y="322" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="345">{dgettext("help_guides", "Sub-groups")}</text>
          <text class="hg-t-sub" x="478" y="362">
            {dgettext("help_guides", "the tree below; apps' records")}
          </text>

          <rect class="hg-row-potok" x="464" y="388" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="411">
            {dgettext("help_guides", "Members and roles")}
          </text>
          <text class="hg-t-sub" x="478" y="428">
            {dgettext("help_guides", "who may do what; notices and push")}
          </text>

          <rect class="hg-row-potok" x="464" y="454" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="477">
            {dgettext("help_guides", "Entities and group fields")}
          </text>
          <text class="hg-t-sub" x="478" y="494">
            {dgettext("help_guides", "types for processes; shared counters")}
          </text>

          <rect class="hg-row-wait" x="464" y="520" width="240" height="52" rx="8" />
          <text class="hg-t-row" x="478" y="543">
            {dgettext("help_guides", "What waits for whom")}
          </text>
          <text class="hg-t-sub" x="478" y="560">
            {dgettext("help_guides", "the “Waiting for you” count, the Processes tab")}
          </text>

          <rect class="hg-row-app" x="40" y="190" width="248" height="52" rx="8" />
          <text class="hg-t-row" x="54" y="213">
            {dgettext("help_guides", "Its own collections")}
          </text>
          <text class="hg-t-mono hg-f-app" x="54" y="230">insertValue · listValues</text>

          <rect class="hg-row-none" x="40" y="256" width="248" height="52" rx="8" />
          <text class="hg-t-note" x="54" y="286">
            {dgettext("help_guides", "does not read the chat")}
          </text>

          <rect class="hg-row-app" x="40" y="322" width="248" height="52" rx="8" />
          <text class="hg-t-row" x="54" y="345">
            {dgettext("help_guides", "Groups below it")}
          </text>
          <text class="hg-t-mono hg-f-app" x="54" y="362">listSubgroups · createChildren</text>

          <rect class="hg-row-app" x="40" y="388" width="248" height="52" rx="8" />
          <text class="hg-t-row" x="54" y="411">{dgettext("help_guides", "Who is looking")}</text>
          <text class="hg-t-mono hg-f-app" x="54" y="428">getCurrentProfile · listRoles</text>

          <rect class="hg-row-none" x="40" y="454" width="248" height="52" rx="8" />
          <text class="hg-t-note" x="54" y="484">
            {dgettext("help_guides", "does not touch group fields")}
          </text>

          <rect class="hg-row-wait" x="40" y="520" width="248" height="52" rx="8" />
          <text class="hg-t-row" x="54" y="543">
            {dgettext("help_guides", "What waits for the viewer")}
          </text>
          <text class="hg-t-mono hg-f-app" x="54" y="560">listWaiting · completeTask</text>

          <rect class="hg-row-proc" x="880" y="190" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="213">
            {dgettext("help_guides", "A new app value")}
          </text>
          <text class="hg-t-sub" x="894" y="230">
            {dgettext("help_guides", "trigger, for a drawing or an app's rule")}
          </text>

          <rect class="hg-row-proc" x="880" y="256" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="279">
            {dgettext("help_guides", "A message in the chat")}
          </text>
          <text class="hg-t-sub" x="894" y="296">
            {dgettext("help_guides", "trigger: a word or a role · step: writes")}
          </text>

          <rect class="hg-row-proc" x="880" y="322" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="345">{dgettext("help_guides", "Sub-group")}</text>
          <text class="hg-t-sub" x="894" y="362">
            {dgettext("help_guides", "trigger: a new sub-group · step: makes one")}
          </text>

          <rect class="hg-row-proc" x="880" y="388" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="411">
            {dgettext("help_guides", "A person and a role")}
          </text>
          <text class="hg-t-sub" x="894" y="428">
            {dgettext("help_guides", "step: form, decision, push to a role")}
          </text>

          <rect class="hg-row-proc" x="880" y="454" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="477">
            {dgettext("help_guides", "An entity and a group field")}
          </text>
          <text class="hg-t-sub" x="894" y="494">
            {dgettext("help_guides", "an entity types the input · step: changes a field")}
          </text>

          <rect class="hg-row-wait" x="880" y="520" width="280" height="52" rx="8" />
          <text class="hg-t-row" x="894" y="543">
            {dgettext("help_guides", "An instance waits for a person")}
          </text>
          <text class="hg-t-sub" x="894" y="560">
            {dgettext("help_guides", "at a form or a decision, until the deadline")}
          </text>

          <line
            class="hg-ar hg-s-app"
            x1="288"
            y1="209"
            x2="464"
            y2="209"
            marker-end="url(#hg-m-app)"
          />
          <text class="hg-t-lab hg-f-app" x="362" y="202" text-anchor="middle">
            {dgettext("help_guides", "writes into its own")}
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="464"
            y1="223"
            x2="288"
            y2="223"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="362" y="237" text-anchor="middle">
            {dgettext("help_guides", "live")}
          </text>

          <line
            class="hg-ar hg-s-app"
            x1="288"
            y1="341"
            x2="464"
            y2="341"
            marker-end="url(#hg-m-app)"
          />
          <text class="hg-t-lab hg-f-app" x="362" y="334" text-anchor="middle">
            {dgettext("help_guides", "makes, if it may")}
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="464"
            y1="355"
            x2="288"
            y2="355"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="362" y="369" text-anchor="middle">
            {dgettext("help_guides", "reads")}
          </text>

          <line
            class="hg-ar hg-s-potok"
            x1="464"
            y1="414"
            x2="288"
            y2="414"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="362" y="407" text-anchor="middle">
            {dgettext("help_guides", "profile, roles")}
          </text>

          <line
            class="hg-ar hg-s-app"
            x1="288"
            y1="539"
            x2="464"
            y2="539"
            marker-end="url(#hg-m-app)"
          />
          <text class="hg-t-lab hg-f-app" x="362" y="532" text-anchor="middle">
            {dgettext("help_guides", "asks, picks an outcome")}
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="464"
            y1="553"
            x2="288"
            y2="553"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-mono hg-f-potok" x="362" y="567" text-anchor="middle">onWaiting</text>

          <line
            class="hg-ar hg-s-potok"
            x1="704"
            y1="216"
            x2="880"
            y2="216"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="806" y="209" text-anchor="middle">
            {dgettext("help_guides", "starts")}
          </text>

          <line
            class="hg-ar hg-s-potok"
            x1="704"
            y1="275"
            x2="880"
            y2="275"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="806" y="268" text-anchor="middle">
            {dgettext("help_guides", "starts")}
          </text>
          <line
            class="hg-ar hg-s-proc"
            x1="880"
            y1="289"
            x2="704"
            y2="289"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="806" y="303" text-anchor="middle">
            {dgettext("help_guides", "writes")}
          </text>

          <line
            class="hg-ar hg-s-potok"
            x1="704"
            y1="341"
            x2="880"
            y2="341"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="806" y="334" text-anchor="middle">
            {dgettext("help_guides", "starts")}
          </text>
          <line
            class="hg-ar hg-s-proc"
            x1="880"
            y1="355"
            x2="704"
            y2="355"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="806" y="369" text-anchor="middle">
            {dgettext("help_guides", "makes")}
          </text>

          <line
            class="hg-ar hg-s-proc"
            x1="880"
            y1="414"
            x2="704"
            y2="414"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="806" y="407" text-anchor="middle">
            {dgettext("help_guides", "asks, sends a push")}
          </text>

          <line
            class="hg-ar hg-s-potok"
            x1="704"
            y1="473"
            x2="880"
            y2="473"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="806" y="466" text-anchor="middle">
            {dgettext("help_guides", "types, values")}
          </text>
          <line
            class="hg-ar hg-s-proc"
            x1="880"
            y1="487"
            x2="704"
            y2="487"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="806" y="501" text-anchor="middle">
            {dgettext("help_guides", "changes a field")}
          </text>

          <line
            class="hg-ar hg-s-proc"
            x1="880"
            y1="539"
            x2="704"
            y2="539"
            marker-end="url(#hg-m-proc)"
          />
          <text class="hg-t-lab hg-f-proc" x="806" y="532" text-anchor="middle">
            {dgettext("help_guides", "waits for someone")}
          </text>
          <line
            class="hg-ar hg-s-potok"
            x1="704"
            y1="553"
            x2="880"
            y2="553"
            marker-end="url(#hg-m-potok)"
          />
          <text class="hg-t-lab hg-f-potok" x="806" y="567" text-anchor="middle">
            {dgettext("help_guides", "answer")}
          </text>

          <text class="hg-t-note" x="44" y="606">
            {dgettext("help_guides", "It does not see Potok's page,")}
          </text>
          <text class="hg-t-note" x="44" y="622">
            {dgettext("help_guides", "its cookies or the drawings of processes.")}
          </text>
          <text class="hg-t-note" x="584" y="606" text-anchor="middle">
            {dgettext("help_guides", "The server checks again")}
          </text>
          <text class="hg-t-note" x="584" y="622" text-anchor="middle">
            {dgettext("help_guides", "every call and every step.")}
          </text>
          <text class="hg-t-note" x="884" y="606">
            {dgettext("help_guides", "Other triggers: a schedule, Start,")}
          </text>
          <text class="hg-t-note" x="884" y="622">
            {dgettext("help_guides", "a call from another process, a signal.")}
          </text>
        </svg>
      </div>
      <figcaption>
        {dgettext(
          "help_guides",
          "Every arrow that enters the group goes through the check of permissions, on the app's side and on the processes' side. An app writes only into its own collections and does not read the chat. A process writes as a member, under its own profile, and people answer it in Potok's dialogs and on the Processes tab. The yellow row is one flow through all three columns: an instance waits for a person, Potok counts that, and the app can show it and let the viewer pick an outcome, with no sight of the drawing. Each run leaves a trace of its steps, with who answered it, on the Processes tab."
        )}
      </figcaption>
    </figure>
    <p id="hg-steps" class="hg-steps">
      <span>
        {dgettext(
          "help_guides",
          "The picture shows the steps that touch the group. All the steps a process is drawn from:"
        )}
      </span>
      <span :for={name <- @steps} class="hg-step-name">{name}</span>
    </p>
  </section>

  <section class="hg-section">
    <h2>{dgettext("help_guides", "One fault, from a tap to a message")}</h2>
    <p>
      <.hg_text
        text={
          dgettext(
            "help_guides",
            "The example is Zgrada Cvetna 12 from the help, with the processes “Reporting a fault” and “Repairer” (<a1>steps 9 and 10</a1>). One thing is added here: the report is started, and its first outcome picked, by an app in the building's description. In the help that is done on the Processes tab, and the process is the same either way."
          )
        }
        links={%{"a1" => "/pomoc/zgrada#kvar"}}
      />
    </p>
    <figure id="hg-fig-seq" class="hg-fig" style="--hg-min: 880px">
      <div class="hg-swipe">{dgettext("help_guides", "The picture scrolls left and right.")}</div>
      <div class="hg-scroll">
        <svg
          viewBox="0 0 1100 820"
          role="img"
          aria-label={
            dgettext(
              "help_guides",
              "A sequence: a resident starts a fault report from the app, the manager picks an outcome in the app, the report calls the process Repairer, which hands back the entity Termin, and a message arrives in the fault's sub-group."
            )
          }
        >
          <rect class="hg-server" x="522" y="6" width="572" height="806" rx="14" />
          <text class="hg-t-lab hg-f-muted" x="1082" y="805" text-anchor="end">
            {dgettext("help_guides", "Potok's server")}
          </text>

          <rect class="hg-hd hg-hd-person" x="10" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row" x="80" y="35" text-anchor="middle">
            {dgettext("help_guides", "Resident")}
          </text>
          <text class="hg-t-sub" x="80" y="51" text-anchor="middle">
            {dgettext("help_guides", "a member of the building")}
          </text>
          <rect class="hg-hd hg-hd-person" x="170" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row" x="240" y="35" text-anchor="middle">
            {dgettext("help_guides", "Manager")}
          </text>
          <text class="hg-t-sub" x="240" y="51" text-anchor="middle">
            {dgettext("help_guides", "the role that decides")}
          </text>
          <rect class="hg-hd hg-hd-app" x="340" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row hg-f-app" x="410" y="35" text-anchor="middle">
            {dgettext("help_guides", "App")}
          </text>
          <text class="hg-t-sub" x="410" y="51" text-anchor="middle">
            {dgettext("help_guides", "in the building's description")}
          </text>
          <rect class="hg-hd hg-hd-potok" x="540" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row hg-f-potok" x="610" y="35" text-anchor="middle">
            {dgettext("help_guides", "Potok")}
          </text>
          <text class="hg-t-sub" x="610" y="51" text-anchor="middle">
            {dgettext("help_guides", "Zgrada Cvetna 12")}
          </text>
          <rect class="hg-hd hg-hd-proc" x="730" y="16" width="140" height="44" rx="10" />
          <text class="hg-t-row hg-f-proc" x="800" y="35" text-anchor="middle">
