#: lib/potok_ide_web/domain_copy.ex:1022
#, elixir-autogen, elixir-format
msgid "Fits in"
msgstr "Uklapa se"

#: lib/potok_ide_web/domain_copy.ex:423
#, elixir-autogen, elixir-format
msgid "Gmail token"
msgstr "Gmail token"

#: lib/potok_ide_web/domain_copy.ex:426
#, elixir-autogen, elixir-format
msgid "Group"
msgstr "Grupa"

#: lib/potok_ide_web/domain_copy.ex:413
#, elixir-autogen, elixir-format
msgid "Group and roles"
msgstr "Grupa i uloge"

#: lib/potok_ide_web/domain_copy.ex:446
#, elixir-autogen, elixir-format
msgid "Group invitation"
msgstr "Pozivnica u grupu"

#: lib/potok_ide_web/domain_copy.ex:577
#, elixir-autogen, elixir-format
msgid "How far a profile has read a group. Everything newer than the last read value is unread. That value is kept as a plain number, with no foreign key."
msgstr "Dokle je profil pročitao grupu. Nepročitano je sve novije od poslednje pročitane vrednosti. Ta vrednost je zapisana kao običan broj, bez spoljnog ključa."

#: lib/potok_ide_web/domain_copy.ex:1112
#, elixir-autogen, elixir-format
msgid "How permissions come about"
msgstr "Kako nastaju dozvole"

#: lib/potok_ide_web/domain_copy.ex:1200
#, elixir-autogen, elixir-format
msgid "How to get into a group"
msgstr "Kako se ulazi u grupu"

#: lib/potok_ide_web/domain_copy.ex:1024
#, elixir-autogen, elixir-format
msgid "It follows the light or dark theme, and keeps each viewer's settings in their browser."
msgstr "Prati svetlu ili tamnu temu, a podešavanja gledaoca čuva u njegovom pregledaču."

#: lib/potok_ide_web/domain_copy.ex:997
#, elixir-autogen, elixir-format
msgid "It gets the viewer's <Profile>profile</Profile> and their <GroupRole>roles</GroupRole> in the group, so it can show different things to different members."
msgstr "Dobija <Profile>profil</Profile> gledaoca i njegove <GroupRole>uloge</GroupRole> u grupi, pa različitim članovima može da pokaže različite stvari."

#: lib/potok_ide_web/domain_copy.ex:449
#, elixir-autogen, elixir-format
msgid "Join request"
msgstr "Zahtev za ulazak"

#: lib/potok_ide_web/domain_copy.ex:418
#, elixir-autogen, elixir-format
