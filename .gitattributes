# Text files are LF in the repo and in every checkout, Windows included
# (this overrides core.autocrlf=true). CRLF working copies break two things:
# - the HEEx formatter turns blank lines into whitespace-only lines, so
#   `mix format` rewrites files nobody touched;
# - shell scripts in the Linux release image: a "#!/bin/sh\r" shebang makes
#   /app/bin/migrate fail with "No such file or directory".
* text=auto eol=lf

# Windows batch files expect CRLF.
*.bat text eol=crlf
