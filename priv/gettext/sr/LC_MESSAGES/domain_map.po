msgid "hour"
msgstr "sat"

#: lib/potok_ide_web/domain_copy.ex:489
#, elixir-autogen, elixir-format
msgid "how much of it"
msgstr "koliko"

#: lib/potok_ide_web/domain_copy.ex:493
